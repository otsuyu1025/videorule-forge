# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local

# ── AI ──────────────────────────────────────────────────────────────────
# Anthropic API キー（ルール候補生成・動画検品に必要）
# console.anthropic.com で取得
ANTHROPIC_API_KEY=sk-ant-...

# ── データベース（クラウド運用時のみ必要）────────────────────────────────
# Supabase の接続文字列（Settings > Database > Connection string）
# DATABASE_URL=postgresql://postgres:[パスワード]@[ホスト]:5432/postgres

# ── Cloudflare R2（フレーム画像ストレージ）──────────────────────────────
# 未設定の場合はローカルに保存（開発環境向け）
# Cloudflare ダッシュボード > R2 > バケット作成 > API トークン発行
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=videorule-frames

# ── ffmpeg / ffprobe ─────────────────────────────────────────────────────
# 省略するとシステムの PATH から検索
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# ── yt-dlp ──────────────────────────────────────────────────────────────
# 省略するとシステムの PATH から検索
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp

# ── フレーム抽出設定 ─────────────────────────────────────────────────────
VIDEO_FRAME_INTERVAL=1   # 何秒ごとに1フレーム抽出するか
VIDEO_FRAME_MAX=30       # 最大フレーム数

# ── OCR用フレーム解像度 ──────────────────────────────────────────────────
VIDEO_OCR_MAX_HEIGHT=720

# ── 機能フラグ ───────────────────────────────────────────────────────────
# SNS動画取得（yt-dlp）: 著作権・利用規約に注意。必要な場合のみ true に変更
# ENABLE_SNS_DOWNLOAD=true

# ── クリーンアップ ───────────────────────────────────────────────────────
# docker-compose の cleanup コンテナからフレーム削除APIを叩く際の認証キー
# 任意の文字列を設定（省略するとセキュリティチェックをスキップ）
# CLEANUP_SECRET=your-random-secret-here
